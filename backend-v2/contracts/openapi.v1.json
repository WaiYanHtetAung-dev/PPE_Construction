  "components": {
    "schemas": {
      "AssignmentInput": {
        "properties": {
          "model_version_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version Id"
          },
          "expected_revision": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 0.0,
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model_version_id",
          "expected_revision"
        ],
        "title": "AssignmentInput"
      },
      "AssignmentOutput": {
        "properties": {
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "model_version": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CatalogModelVersion"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "revision",
          "model_version"
        ],
        "title": "AssignmentOutput"
      },
      "CameraInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Name"
          },
          "stream_ref": {
            "type": "string",
            "maxLength": 255,
            "minLength": 8,
            "pattern": "^stream:[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$",
            "title": "Stream Ref"
