FROM python:3.12-slim AS base
WORKDIR /srv/ppe
COPY requirements-inference.txt .
RUN python -m pip install --no-cache-dir -r requirements-inference.txt
COPY app/__init__.py app/model_artifacts.py app/model_artifact_integrity.py app/
COPY app/contracts app/contracts
COPY inference_worker inference_worker
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001

FROM base AS cpu
USER root
COPY requirements-inference-cpu.txt .
RUN python -m pip install --no-cache-dir -r requirements-inference-cpu.txt
USER 10001:10001

FROM base AS standard
